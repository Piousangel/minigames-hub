{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minigames-hub",
  "compatibility_date": "2026-07-14",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minigames-leaderboard",
      "database_id": "c99eaae9-e197-4020-b718-a3d599949f70"
    }
  ],
  // 1st-party 분석: 게임별 조회·체류를 Analytics Engine에 기록(외부 요청·CSP·토큰 불필요).
  // 대시보드에서 mg_events 데이터셋 생성/활성화 완료(2026-07-20) → 바인딩 활성.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "mg_events" }],
  "routes": [{ "pattern": "quickminigames.site", "custom_domain": true }]
}
