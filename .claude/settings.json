{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.dev.vars)",
      "Read(.dev.vars.*)",
      "Read(~/.ssh/**)",
      "Read(~/.wrangler/**)",
      "Read(~/Library/Preferences/.wrangler/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge *--admin*)",
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler deploy *)",
      "Bash(pnpm exec wrangler deploy *)",
      "Bash(pnpm wrangler deploy *)",
      "Bash(wrangler versions deploy *)",
      "Bash(pnpm run deploy*)",
      "Bash(npm run deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-unsaved-work.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
